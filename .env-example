# ==============================================================================
# Global / Docker Deployment Environment Configuration
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=index_aeli_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/index_aeli_db?sslmode=disable

# Authentication
JWT_SECRET=supersecretjwtkey123!

# Service Ports
WEB_PORT=7007
CMS_PORT=7008
GATEWAY_PORT=7009
IDENTITY_PORT=7010
CONTENT_PORT=7011
PROGRAM_PORT=7012
MEDIA_PORT=7013

# Microservice URLs (Client & Container Network)
NEXT_PUBLIC_API_URL=http://localhost:7009
INTERNAL_API_URL=http://api-gateway:7009

# Web Application Pricing & Tax Configuration
NEXT_PUBLIC_TAX_PERCENT=10
